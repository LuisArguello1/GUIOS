# ==============================================================================
# GUIOS - Guía Unificada de Interfaz y Operación de Sistemas
# Plantilla de Variables de Entorno (.env.example)
# ==============================================================================

# ── Seguridad y Django ────────────────────────────────────────────────────────
SECRET_KEY='clave-secreta-de-desarrollo-cambiar-en-produccion'
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8050

# Cookies seguras para JWT (False en desarrollo HTTP local, True para HTTPS en producción)
JWT_COOKIE_SECURE=False

# Puerto del Servidor Backend (Waitress o Runserver)
PORT=8050

# ── Base de Datos ─────────────────────────────────────────────────────────────
# Motor PostgreSQL recomendado; si se omite DB_ENGINE, Django usa db.sqlite3 por defecto
DB_ENGINE=django.db.backends.postgresql
DB_NAME=guios_db
DB_USER=postgres
DB_PASSWORD=su_password
DB_HOST=localhost
DB_PORT=5432

# ── Configuración de Correo Electrónico (SMTP) ────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_HOST_USER="tucorreo@gmail.com"
EMAIL_HOST_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="tucorreo@gmail.com"

# Cuota Diaria de Correos
DAILY_EMAIL_LIMIT=500

# Nombre del Emisor para Autenticación 2FA (TOTP)
TOTP_ISSUER_NAME=GUIOS

# ── Configuración del Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=/api/v1/
VITE_BACKEND_URL=http://localhost:8050/

# ── Redis & Celery (Broker de Mensajería y Caché) ─────────────────────────────
# Requisito obligatorio para procesamiento en segundo plano de tareas de IA
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── Motor de Inteligencia Artificial (GUIOS PRO) ──────────────────────────────
# Proveedor cognitivo activo: 'azure', 'groq', 'cohere' o 'heuristic'
AI_PROVIDER=azure

# Proveedor 1: Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://tu-recurso.services.ai.azure.com/models
AZURE_OPENAI_API_KEY=tu_clave_azure_openai_aqui
AZURE_OPENAI_MODEL=gpt-5-mini

# Proveedor 2: Groq (Inferencia ultra-rápida LPU)
GROQ_API_KEY=tu_clave_api_groq_aqui
GROQ_MODEL=qwen/qwen3.8-27b

# Proveedor 3: Cohere
COHERE_API_KEY=tu_clave_api_cohere_aqui
COHERE_MODEL=command-r-plus-08-2024

# Tiempo de espera máximo para peticiones de IA (en segundos)
AI_TIMEOUT_SECONDS=30

# ── Motor Bibliométrico Académico (OpenAlex API) ──────────────────────────────
# Consulta en tiempo real de literatura científica indexada
OPENALEX_API_URL=https://api.openalex.org/works
OPENALEX_MAILTO=soporte@guios.org
OPENALEX_TIMEOUT_SECONDS=15
OPENALEX_MAX_RESULTS=80
OPENALEX_YEAR_FROM=2020
OPENALEX_YEAR_TO=2025
OPENALEX_API_KEY=
